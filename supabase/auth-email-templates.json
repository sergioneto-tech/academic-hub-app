{
  "mailer_subjects_confirmation": "Confirma a tua conta Academic Hub",
  "mailer_templates_confirmation_content": "<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:600px;margin:0 auto;padding:28px;color:#0B1D3A;background:#ffffff\"><div style=\"border:1px solid #d9dee7;border-radius:16px;overflow:hidden\"><div style=\"background:#0B1D3A;padding:20px 26px;color:#ffffff\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"vertical-align:middle;padding-right:14px\"><img src=\"https://academichub.sergioneto.pt/academic-hub-icon-v9-192.png\" width=\"56\" height=\"56\" alt=\"Academic Hub\" style=\"display:block;width:56px;height:56px;border:0;border-radius:10px\"></td><td style=\"vertical-align:middle\"><div style=\"font-size:22px;font-weight:700;color:#ffffff\">Academic Hub</div><div style=\"margin-top:4px;font-size:13px;color:#d8b868\">Gestão académica pessoal</div></td></tr></table></div><div style=\"padding:26px\"><h2 style=\"margin:0 0 14px;font-size:20px\">Confirma a tua conta</h2><p style=\"font-size:15px;line-height:1.6;color:#475569\">Foi criada uma conta Academic Hub com este endereço institucional da Universidade Aberta. Para concluir o registo e ativar a sincronização dos teus dados académicos, confirma o email através do botão abaixo.</p><p style=\"margin:26px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#17479E;color:#ffffff;text-decoration:none;font-weight:700;padding:12px 20px;border-radius:10px\">Confirmar conta</a></p><p style=\"font-size:13px;line-height:1.5;color:#64748b\">Se não efetuaste este registo, podes ignorar esta mensagem.</p></div></div><p style=\"text-align:center;font-size:12px;color:#94a3b8;margin-top:18px\">Academic Hub · Gestão académica pessoal</p></div>",
  "mailer_subjects_email_change": "Confirma o novo email UAb da tua conta Academic Hub",
  "mailer_templates_email_change_content": "<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:600px;margin:0 auto;padding:28px;color:#0B1D3A;background:#ffffff\"><div style=\"border:1px solid #d9dee7;border-radius:16px;overflow:hidden\"><div style=\"background:#0B1D3A;padding:20px 26px;color:#ffffff\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"vertical-align:middle;padding-right:14px\"><img src=\"https://academichub.sergioneto.pt/academic-hub-icon-v9-192.png\" width=\"56\" height=\"56\" alt=\"Academic Hub\" style=\"display:block;width:56px;height:56px;border:0;border-radius:10px\"></td><td style=\"vertical-align:middle\"><div style=\"font-size:22px;font-weight:700;color:#ffffff\">Academic Hub</div><div style=\"margin-top:4px;font-size:13px;color:#d8b868\">Regularização da conta</div></td></tr></table></div><div style=\"padding:26px\"><h2 style=\"margin:0 0 14px;font-size:20px\">Confirma o teu email institucional</h2><p style=\"font-size:15px;line-height:1.6;color:#475569\">Foi solicitada a alteração do endereço da tua conta para <strong>{{ .NewEmail }}</strong>. Confirma este endereço para manteres a mesma conta, os mesmos dados e o acesso à sincronização.</p><p style=\"margin:26px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#17479E;color:#ffffff;text-decoration:none;font-weight:700;padding:12px 20px;border-radius:10px\">Confirmar novo email</a></p><p style=\"font-size:13px;line-height:1.5;color:#64748b\">Se não pediste esta alteração, ignora a mensagem e mantém a tua conta protegida.</p></div></div><p style=\"text-align:center;font-size:12px;color:#94a3b8;margin-top:18px\">Academic Hub · Gestão académica pessoal</p></div>",
  "mailer_subjects_recovery": "Recuperar a password do Academic Hub",
  "mailer_templates_recovery_content": "<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:600px;margin:0 auto;padding:28px;color:#0B1D3A;background:#ffffff\"><div style=\"border:1px solid #d9dee7;border-radius:16px;overflow:hidden\"><div style=\"background:#0B1D3A;padding:20px 26px;color:#ffffff\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"vertical-align:middle;padding-right:14px\"><img src=\"https://academichub.sergioneto.pt/academic-hub-icon-v9-192.png\" width=\"56\" height=\"56\" alt=\"Academic Hub\" style=\"display:block;width:56px;height:56px;border:0;border-radius:10px\"></td><td style=\"vertical-align:middle\"><div style=\"font-size:22px;font-weight:700;color:#ffffff\">Academic Hub</div><div style=\"margin-top:4px;font-size:13px;color:#d8b868\">Segurança da conta</div></td></tr></table></div><div style=\"padding:26px\"><h2 style=\"margin:0 0 14px;font-size:20px\">Recuperar a password</h2><p style=\"font-size:15px;line-height:1.6;color:#475569\">Recebemos um pedido para definir uma nova password para a tua conta Academic Hub.</p><p style=\"margin:26px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#17479E;color:#ffffff;text-decoration:none;font-weight:700;padding:12px 20px;border-radius:10px\">Definir nova password</a></p><p style=\"font-size:13px;line-height:1.5;color:#64748b\">Se não fizeste este pedido, podes ignorar esta mensagem.</p></div></div><p style=\"text-align:center;font-size:12px;color:#94a3b8;margin-top:18px\">Academic Hub · Gestão académica pessoal</p></div>"
